# Copy this template to backend/.env, not the repository root.
# Leave AWS_PROFILE unset to use the standard AWS credential chain.
# AWS_PROFILE=your-profile
BEDROCK_MODEL_ID=
# Optional external model: explicitly select openai-compatible and fill all three fields.
LLM_PROVIDER=bedrock
LLM_MODEL_ID=
LLM_BASE_URL=
LLM_API_KEY=
STUDYPILOT_AWS_REGION=us-east-1
STUDYPILOT_FIXTURE_MODE=true
STUDYPILOT_LOCAL_LIVE_UI=false
STUDYPILOT_AGENTCORE_RUNTIME_ARN=
STUDYPILOT_DATABASE_PATH=./data/studypilot.sqlite3
